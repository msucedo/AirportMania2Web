{
  "name": "airport-mania-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "import-assets": "node tools/import-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/build-precache.mjs",
    "serve:https": "node tools/serve-https.mjs",
    "phone": "npm run build && node tools/serve-https.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
